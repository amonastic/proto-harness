{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:h01:external-reference.schema.json",
  "title": "H01 External Reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reference_id", "reference_kind", "locator", "status", "source_refs", "scope"],
  "properties": {
    "schema_version": { "const": "h01-external-reference-v1" },
    "scope": { "type": "string", "minLength": 1 },
    "reference_id": { "type": "string", "minLength": 1, "pattern": "^X-[A-Z0-9][A-Z0-9-]*$" },
    "reference_kind": { "type": "string", "enum": ["incident", "fixture", "rule-admission", "run", "oracle", "adapter"] },
    "locator": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["active", "superseded"] },
    "source_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}

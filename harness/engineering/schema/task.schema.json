{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:h01:task.schema.json",
  "title": "H01 Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "title", "task_type", "scope", "status", "source_refs", "ruleset_id"],
  "properties": {
    "schema_version": { "const": "h01-task-v1" },
    "task_id": { "type": "string", "minLength": 1, "pattern": "^TASK-[A-Z0-9][A-Z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "task_type": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["planned", "active", "blocked", "completed", "cancelled"] },
    "source_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "ruleset_id": { "type": "string", "minLength": 1, "pattern": "^RULESET-[A-Z0-9][A-Z0-9-]*$" }
  }
}

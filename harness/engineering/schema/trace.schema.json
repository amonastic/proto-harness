{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:h01:trace.schema.json",
  "title": "H01 Trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "run_id", "task_id", "ruleset_id", "epoch_id", "fixture_suite_ref", "oracle_ref", "adapter_ref", "events", "terminal_state", "status", "scope", "source_refs"],
  "properties": {
    "schema_version": { "const": "h01-trace-v1" },
    "scope": { "type": "string", "minLength": 1 },
    "source_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "trace_id": { "type": "string", "minLength": 1, "pattern": "^TRACE-[A-Z0-9][A-Z0-9-]*$" },
    "run_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1, "pattern": "^TASK-[A-Z0-9][A-Z0-9-]*$" },
    "ruleset_id": { "type": "string", "minLength": 1, "pattern": "^RULESET-[A-Z0-9][A-Z0-9-]*$" },
    "epoch_id": { "type": "string", "minLength": 1, "pattern": "^EPOCH-[A-Z0-9][A-Z0-9-]*$" },
    "fixture_suite_ref": { "type": "string", "minLength": 1 },
    "oracle_ref": { "type": "string", "minLength": 1 },
    "adapter_ref": { "type": "string", "minLength": 1 },
    "events": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "state_from", "state_to", "event_type", "result_code"],
        "properties": {
          "sequence": { "type": "integer" },
          "state_from": { "type": "string", "minLength": 1 },
          "state_to": { "type": "string", "minLength": 1 },
          "event_type": { "type": "string", "enum": ["tool", "verification", "state-transition", "model", "error"] },
          "result_code": { "type": "string", "minLength": 1 },
          "tool_result": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool", "summary"],
            "properties": {
              "tool": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "terminal_state": { "type": "string", "enum": ["PENDING", "COMPLETED", "FAILED", "ABORTED"] },
    "status": { "type": "string", "enum": ["in-progress", "completed", "failed", "aborted"] }
  }
}

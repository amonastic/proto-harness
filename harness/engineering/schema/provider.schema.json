{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:h01:provider.schema.json",
  "title": "H01 Provider",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider_id", "role", "status", "request_schema", "result_schema", "source_refs", "scope"],
  "properties": {
    "schema_version": { "const": "h01-provider-v1" },
    "scope": { "type": "string", "minLength": 1 },
    "provider_id": { "type": "string", "minLength": 1, "pattern": "^(P|J)-[A-Z0-9][A-Z0-9-]*$" },
    "role": { "type": "string", "enum": ["execution-selected", "judge-selected", "local-fixture"] },
    "status": { "type": "string", "enum": ["selected-pending-smoke", "callable-confirmed"] },
    "request_schema": { "type": "string", "minLength": 1 },
    "result_schema": { "type": "string", "minLength": 1 },
    "source_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}

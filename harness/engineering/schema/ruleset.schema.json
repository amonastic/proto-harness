{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:h01:ruleset.schema.json",
  "title": "H01 Ruleset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ruleset_id", "source_refs", "owner_registry_sha256", "compiler_version", "route_version", "status", "supersedes", "scope"],
  "properties": {
    "schema_version": { "const": "h01-ruleset-v1" },
    "scope": { "type": "string", "minLength": 1 },
    "ruleset_id": { "type": "string", "minLength": 1, "pattern": "^RULESET-[A-Z0-9][A-Z0-9-]*$" },
    "source_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "owner_registry_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "compiler_version": { "type": "string", "minLength": 1 },
    "route_version": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["active", "superseded"] },
    "supersedes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}

{
  "version": "0.2.1",
  "updatedAt": "2026-05-11",
  "purpose": "为关键页面建立既有功能与信息结构基线，避免后续新增字段时误改未被指令覆盖的既有功能。",
  "baselineRules": {
    "defaultMode": "protect-existing",
    "allowedChangeTypes": [
      "safe-add",
      "safe-reorder",
      "visual-tightening",
      "breaking-change"
    ],
    "defaultInterpretation": {
      "safe-add": "允许新增字段、标签和紧凑信息位，不删除既有字段和动作，不新增说明区或额外功能模块",
      "safe-reorder": "允许在不改变信息语义的前提下做局部重排，以容纳新增信息",
      "visual-tightening": "允许压缩间距、重排布局，但保留既有功能和层级",
      "breaking-change": "涉及删除字段、修改按钮语义、修改状态逻辑或删除既有区域，必须显式说明"
    }
  },
  "requiredBaselineSections": [
    "page-purpose",
    "clone-source",
    "change-type",
    "protected-fields",
    "protected-actions",
    "protected-statuses",
    "allowed-additions",
    "do-not-change-without-explicit-request"
  ],
  "referenceBaselines": {
    "selectionRule": "执行页面、抽屉或视觉统一前，先按平台确认成熟基准；如果用户点名的旧入口已跳转或不再承载真实内容，必须继续定位其当前承载页和 docs 数据源。",
    "uiWeighting": {
      "latestIterationIndex": 7,
      "historicalExcellentUi": 3,
      "rule": "最新迭代索引决定结构、入口、信息层级和页面组织，历史优秀 UI 用于视觉质感、间距、卡片和局部完成度收口；不得机械平均 CSS 数值。"
    },
    "platforms": {

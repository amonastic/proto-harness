  "purpose": "登记仓库规则载体、canonical 归属、镜像关系与重复主题；供只读规则审计使用。",
  "policy": {
    "mainEntry": "AGENTS.md",
    "mirrorStrategy": "validate-only",
    "mirrorGrowth": "frozen",
    "notes": [
      "archive 条目只作为过程材料登记，不参与当前规则优先级。",
      "ui-ux-pro-max 当前存在 legacy 与 searchable 两个已验证内容变体，分别冻结为两个镜像组。",
      ".github/prompts 下仅 PROMPT.md 视为规则载体；data、scripts 与缓存属于能力载荷，不纳入规则地图。",
      "规则地图不登记 standards/ui-spec.json 内的业务页面清单内容，只登记该标准文件本身。"
    ]
  },
  "discovery": [
    {
      "kind": "exact",
      "paths": [
        "AGENTS.md",
        "DEVELOPMENT.md",
        "CLAUDE.md",
        "产品-规则说明.md"
      ]
    },
    {
      "kind": "glob",
      "pattern": "harness/**/*.md"
    },
    {
      "kind": "glob",
      "pattern": "standards/*.{json,md}"
    },
    {
      "kind": "glob",
      "pattern": ".codebuddy/rules/*.mdc"
    },
    {
      "kind": "glob",
      "pattern": ".agents/skills/*/SKILL.md"
    },
    {
      "kind": "glob",
      "pattern": ".claude/skills/*/SKILL.md"
